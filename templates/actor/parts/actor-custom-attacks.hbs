<section class="custom-attacks-section">
  <div class="custom-attack-list-section custom-attack-list-section-attacks">
    <div class="custom-attacks-header">
      <h3>Attacks</h3>
      <a class="custom-attack-add task-control" title="Add Attack">
        <i class="fas fa-plus"></i>
        New Attack
      </a>
    </div>

    <div class="custom-attack-table custom-attack-table-attacks">
      <div class="custom-attack-table-row custom-attack-table-header" aria-hidden="true">
        <div>Name</div>
        <div>To-Hit Bonus</div>
        <div>Damage</div>
        <div>Damage Type</div>
        <div>Advantage</div>
        <div>Roll</div>
        <div>Remove</div>
      </div>

      {{#if customAttackGroups.attacks.length}}
        {{#each customAttackGroups.attacks as |entry|}}
          <div class="custom-attack-table-row custom-attack-entry-row custom-attack-entry-row-attack">
            <div class="custom-attack-field custom-attack-field-name">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.name">Name</label>
              <input
                type="text"
                name="system.customAttacks.{{entry.index}}.name"
                value="{{entry.name}}"
                placeholder="Attack Name"
              />
              <input type="hidden" name="system.customAttacks.{{entry.index}}.kind" value="{{entry.kind}}" />
              <input type="hidden" name="system.customAttacks.{{entry.index}}.advantageModifier" value="{{entry.advantageModifier}}" data-dtype="Number" />
            </div>
            <div class="custom-attack-field">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.toHitBonus">To-Hit Bonus</label>
              <input
                type="text"
                name="system.customAttacks.{{entry.index}}.toHitBonus"
                value="{{entry.toHitBonus}}"
                placeholder="+0"
              />
            </div>
            <div class="custom-attack-field">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.damage">Damage</label>
              <input
                type="text"
                name="system.customAttacks.{{entry.index}}.damage"
                value="{{entry.damage}}"
                placeholder="1d6"
              />
            </div>
            <div class="custom-attack-field">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.damageType">Damage Type</label>
              <select name="system.customAttacks.{{entry.index}}.damageType">
                <option value="" {{#if (eq entry.damageType "")}}selected{{/if}}>No Damage Type</option>
                {{#each @root.damageTypeGroups as |group|}}
                  <optgroup label="{{group.label}}">
                    {{#each group.options as |option|}}
                      <option value="{{option.value}}" {{#if (eq option.value ../../damageType)}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </optgroup>
                {{/each}}
              </select>
            </div>
            <div class="custom-attack-field custom-attack-advantage-cell">
              <span class="stat-label">Advantage</span>
              <div class="custom-attack-advantage-control" aria-label="Attack advantage modifier">
                <button
                  type="button"
                  class="custom-attack-advantage-adjust"
                  data-index="{{entry.index}}"
                  data-delta="-1"
                  title="Subtract Advantage"
                  aria-label="Subtract Advantage"
                >
                  -
                </button>
                <input
                  type="text"
                  class="custom-attack-advantage-display"
                  value="{{signedNumber entry.advantageModifier}}"
                  readonly
                  aria-label="Attack advantage modifier value"
                />
                <button
                  type="button"
                  class="custom-attack-advantage-adjust"
                  data-index="{{entry.index}}"
                  data-delta="1"
                  title="Add Advantage"
                  aria-label="Add Advantage"
                >
                  +
                </button>
              </div>
            </div>
            <div class="custom-attack-field custom-attack-action-cell">
              <span class="stat-label">Roll</span>
              <button type="button" class="custom-attack-roll" data-index="{{entry.index}}">
                Roll Attack
              </button>
            </div>
            <div class="custom-attack-field custom-attack-action-cell custom-attack-remove-cell">
              <span class="stat-label">Remove</span>
              <a class="custom-attack-remove task-control task-delete" data-index="{{entry.index}}" title="Remove Attack" aria-label="Remove Attack">
                <i class="fas fa-minus"></i>
              </a>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="custom-attack-empty-row">
          No attacks added.
        </div>
      {{/if}}
    </div>
  </div>

  <div class="custom-attack-list-section custom-attack-list-section-saves">
    <div class="custom-attacks-header">
      <h3>Saving Throws</h3>
      <a class="custom-save-add task-control" title="Add Saving Throw">
        <i class="fas fa-plus"></i>
        New Saving Throw
      </a>
    </div>

    <div class="custom-attack-table custom-attack-table-saves">
      <div class="custom-attack-table-row custom-attack-table-header" aria-hidden="true">
        <div>Name</div>
        <div>Save Type</div>
        <div>DC</div>
        <div>Damage</div>
        <div>Damage Type</div>
        <div>Roll</div>
        <div>Remove</div>
      </div>

      {{#if customAttackGroups.saves.length}}
        {{#each customAttackGroups.saves as |entry|}}
          <div class="custom-attack-table-row custom-attack-entry-row custom-attack-entry-row-save">
            <div class="custom-attack-field custom-attack-field-name">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.name">Name</label>
              <input
                type="text"
                name="system.customAttacks.{{entry.index}}.name"
                value="{{entry.name}}"
                placeholder="Saving Throw Name"
              />
              <input type="hidden" name="system.customAttacks.{{entry.index}}.kind" value="{{entry.kind}}" />
              <input type="hidden" name="system.customAttacks.{{entry.index}}.advantageModifier" value="{{entry.advantageModifier}}" data-dtype="Number" />
            </div>
            <div class="custom-attack-field">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.saveType">Save Type</label>
              <select name="system.customAttacks.{{entry.index}}.saveType">
                <option value="" {{#if (eq entry.saveType "")}}selected{{/if}}>Select Save Type</option>
                {{#each @root.customAttackSaveTypes as |saveType|}}
                  <option value="{{saveType}}" {{#if (eq saveType ../saveType)}}selected{{/if}}>{{saveType}}</option>
                {{/each}}
              </select>
            </div>
            <div class="custom-attack-field custom-attack-field-dc">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.dc">DC</label>
              <input
                type="text"
                name="system.customAttacks.{{entry.index}}.dc"
                value="{{entry.dc}}"
                placeholder="10"
              />
            </div>
            <div class="custom-attack-field">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.damage">Damage</label>
              <input
                type="text"
                name="system.customAttacks.{{entry.index}}.damage"
                value="{{entry.damage}}"
                placeholder="2d6"
              />
            </div>
            <div class="custom-attack-field">
              <label class="stat-label" for="system.customAttacks.{{entry.index}}.damageType">Damage Type</label>
              <select name="system.customAttacks.{{entry.index}}.damageType">
                <option value="" {{#if (eq entry.damageType "")}}selected{{/if}}>No Damage Type</option>
                {{#each @root.damageTypeGroups as |group|}}
                  <optgroup label="{{group.label}}">
                    {{#each group.options as |option|}}
                      <option value="{{option.value}}" {{#if (eq option.value ../../damageType)}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </optgroup>
                {{/each}}
              </select>
            </div>
            <div class="custom-attack-field custom-attack-action-cell">
              <span class="stat-label">Roll</span>
              <button type="button" class="custom-attack-roll" data-index="{{entry.index}}">
                Roll Saving Throw
              </button>
            </div>
            <div class="custom-attack-field custom-attack-action-cell custom-attack-remove-cell">
              <span class="stat-label">Remove</span>
              <a class="custom-attack-remove task-control task-delete" data-index="{{entry.index}}" title="Remove Saving Throw" aria-label="Remove Saving Throw">
                <i class="fas fa-minus"></i>
              </a>
            </div>
          </div>
        {{/each}}
      {{else}}
        <div class="custom-attack-empty-row">
          No saving throws added.
        </div>
      {{/if}}
    </div>
  </div>
</section>
